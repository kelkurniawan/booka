# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Template env boleh ikut ter-commit; nilainya kosong.
!.env.example

# Claude Code: config lokal per-user, jangan ikut ter-commit
.claude/settings.local.json

# Kredensial OAuth yang diunduh dari Google Cloud Console. File ini berisi
# client_secret dan TIDAK boleh masuk repo — secretnya dipasang di Supabase
# (Authentication > Providers > Google), bukan di kode.
client_secret_*.json
