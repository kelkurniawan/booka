# ---------------------------------------------------------------------------
# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK boleh di-commit (sudah ada di .gitignore).
# ---------------------------------------------------------------------------

# --- Aplikasi -------------------------------------------------------------
# URL publik aplikasi. Dipakai untuk redirect OAuth & link di email/WhatsApp.
# Boleh dikosongkan saat development; default http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nomor WhatsApp tim Booka untuk permintaan upgrade/downgrade paket (format
# internasional tanpa '+', misal 6281234567890). Opsional -- tombol upgrade di
# halaman Langganan disembunyikan kalau kosong. Tidak ada pembayaran langganan
# otomatis; perubahan paket masih ditangani manual lewat WhatsApp.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Supabase -------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Publishable key (format baru, diawali `sb_publishable_`). Aman diekspos ke
# browser — hak aksesnya ditentukan RLS, bukan oleh kunci ini.
# Project lama yang masih memakai anon key JWT bisa mengisi
# NEXT_PUBLIC_SUPABASE_ANON_KEY sebagai gantinya; keduanya diterima.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RAHASIA. Secret key (format baru, diawali `sb_secret_`) atau service role key
# JWT lama. MELEWATI SELURUH RLS — jangan pernah diekspos ke browser dan jangan
# dijadikan build arg Docker.
# Baru dibutuhkan mulai Phase 4 (API booking, webhook, cron).
SUPABASE_SECRET_KEY=

# --- Enkripsi kredensial merchant ----------------------------------------
# Kunci AES-256-GCM untuk mengenkripsi access/refresh token payment gateway
# milik merchant sebelum disimpan ke database.
# Generate dengan: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Payment: Midtrans (platform / partner account) -----------------------
# Kredensial akun PLATFORM untuk OAuth Connect ke akun merchant.
# Didapat setelah akun Anda disetujui program "Midtrans for Platform".
MIDTRANS_CLIENT_ID=
MIDTRANS_CLIENT_SECRET=
# 'sandbox' atau 'production'
MIDTRANS_ENV=sandbox

# --- Payment: Xendit (xenPlatform) ----------------------------------------
# Kredensial akun PLATFORM Xendit untuk account linking / OAuth.
XENDIT_CLIENT_ID=
XENDIT_CLIENT_SECRET=
XENDIT_SECRET_KEY=
# 'sandbox' atau 'production'
XENDIT_ENV=sandbox

# --- Cron (Vercel Cron / QStash) ------------------------------------------
# Token acak untuk memverifikasi request ke /api/cron/*
# Generate dengan: openssl rand -hex 32
CRON_SECRET=

# --- Notifikasi (semuanya opsional, lihat docs/NOTIFIKASI.md) ------------
# Email ke merchant saat DP dibayar, lewat Resend (paket gratis cukup).
RESEND_API_KEY=
# Wajib alamat di domain yang sudah diverifikasi di Resend.
EMAIL_FROM=

# WhatsApp ke merchant & pelanggan. 'waha' | 'evolution' | 'fonnte'.
WHATSAPP_PROVIDER=
# Base URL gateway self-host (WAHA/Evolution), wajib HTTPS. Kosongkan untuk Fonnte.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
# Nama sesi WAHA / instance Evolution. Default: default
WHATSAPP_SESSION=

# --- Pemantauan error: Sentry (opsional, paket gratis) --------------------
# Tanpa DSN, Sentry mati sepenuhnya. DSN memang publik (ikut ke browser).
# Token akses booking di /pesanan/{token}, nomor WA, dan email disensor
# sebelum dikirim -- lihat src/lib/monitoring/scrub.ts.
NEXT_PUBLIC_SENTRY_DSN=
# Opsional, hanya untuk mengunggah source map saat build (stack trace terbaca).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Domain sendiri merchant Studio (opsional) ---------------------------
# Token Vercel (Account Settings > Tokens) dengan akses ke proyek ini, dan id
# proyeknya (Project Settings > General). VERCEL_TEAM_ID hanya bila proyek
# berada di team. Tanpa dua nilai pertama, halaman Domain menampilkan
# "belum diaktifkan".
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
